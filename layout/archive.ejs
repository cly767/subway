<main id="contents">
	<ul class="postList">
        <% let prev_year = -1;
        page.posts.forEach((item) => {
            if(item.date.year() != prev_year) {
                prev_year = item.date.year(); %>
        <div class="yearHeader"><%- prev_year %></div>
        <% } %>
		<li>
			<article class="entry">
			<a href="<%- url_for(item.path) %>"><%- item.title %></a>
			<div class="date"><%- item.date.format('MMM DD, YYYY') %></div>
			</article>
		</li>
		<% }) %>
	</ul>
</main>
<hr/>
<div id="paginator">
	<div id="paginator-indicator">Page <%= page.current %>, Total <%= page.total %>.</div>
	<div id="paginator-controls">
	<% if(page.prev !== 0) { %>
	<a class="button outlined" href="<%- url_for(page.prev_link) %>">PREV</a>
	<% } %>
	<% if(page.next !== 0) { %>
	<a class="button outlined" href="<%- url_for(page.next_link) %>">NEXT</a>
	<% } %>
	</div>
</div>